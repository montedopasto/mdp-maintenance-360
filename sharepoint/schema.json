{
  "version": 1,
  "locale": "pt-PT",
  "siteName": "MDP Maintenance 360",
  "private": true,
  "lists": [
    {"name":"MDP_Unidades","description":"Hierarquia de unidades e localizações, sem limite fixo de níveis.","columns":[
      {"name":"UnidadeSuperiorId","number":{"decimalPlaces":"none","minimum":1},"indexed":true},
      {"name":"Codigo","text":{"maxLength":80},"indexed":true},
      {"name":"Ativo","boolean":{},"defaultValue":{"value":"1"}}
    ]},
    {"name":"MDP_Equipamentos","description":"Equipamentos associados a uma unidade. Sem periodicidade de manutenção na ficha.","columns":[
      {"name":"UnidadeId","number":{"decimalPlaces":"none","minimum":1},"required":true,"indexed":true},
      {"name":"Codigo","text":{"maxLength":80},"indexed":true},
      {"name":"Estado","choice":{"choices":["Operacional","Em manutenção","Inativo","Por verificar"],"allowTextEntry":false}},
      {"name":"Caracteristicas","text":{"allowMultipleLines":true,"maxLength":10000}},
      {"name":"EliminadoEm","dateTime":{"displayAs":"default","format":"dateTime"}}
    ]},
    {"name":"MDP_Trabalhos","description":"Registos dos técnicos. A periodicidade é opcional e pertence ao trabalho, nunca ao equipamento.","columns":[
      {"name":"EquipamentoId","number":{"decimalPlaces":"none","minimum":1},"required":true,"indexed":true},
      {"name":"DataTrabalho","dateTime":{"displayAs":"default","format":"dateOnly"},"required":true,"indexed":true},
      {"name":"TipoManutencao","choice":{"choices":["Corretiva","Preventiva","Proativa","Preditiva","Inspeção"],"allowTextEntry":false},"required":true},
      {"name":"EstadoTrabalho","choice":{"choices":["Planeado","Em curso","Concluído"],"allowTextEntry":false},"required":true},
      {"name":"ResponsavelId","text":{"maxLength":200},"required":true,"indexed":true},
      {"name":"ResponsavelNome","text":{"maxLength":200},"required":true},
      {"name":"Descricao","text":{"allowMultipleLines":true,"maxLength":10000},"required":true},
      {"name":"Horas","number":{"decimalPlaces":"two","minimum":0}},
      {"name":"CustoEUR","number":{"decimalPlaces":"two","minimum":0}},
      {"name":"Materiais","text":{"allowMultipleLines":true,"maxLength":10000}},
      {"name":"Observacoes","text":{"allowMultipleLines":true,"maxLength":10000}},
      {"name":"PeriodicidadeDias","number":{"decimalPlaces":"none","minimum":1}},
      {"name":"TrabalhoOrigemId","number":{"decimalPlaces":"none","minimum":1},"indexed":true},
      {"name":"ProximaData","dateTime":{"displayAs":"default","format":"dateOnly"},"indexed":true},
      {"name":"PedidoId","text":{"maxLength":80},"indexed":true,"enforceUniqueValues":true,"required":true}
    ]},
    {"name":"MDP_Utilizadores","description":"Perfis e permissões da aplicação. Apenas identificadores de identidade, sem palavras-passe nem PIN.","columns":[
      {"name":"IdentidadeId","text":{"maxLength":200},"indexed":true,"enforceUniqueValues":true,"required":true},
      {"name":"Provedor","choice":{"choices":["Office365","Externo"],"allowTextEntry":false},"required":true},
      {"name":"Email","text":{"maxLength":254}},
      {"name":"Perfil","choice":{"choices":["Administrador","Técnico"],"allowTextEntry":false},"required":true},
      {"name":"Ativo","boolean":{},"defaultValue":{"value":"1"}}
    ]},
    {"name":"MDP_Auditoria","description":"Registo de alterações efetuadas pela aplicação.","columns":[
      {"name":"AtorId","text":{"maxLength":200},"required":true,"indexed":true},
      {"name":"DataEvento","dateTime":{"displayAs":"default","format":"dateTime"},"required":true,"indexed":true},
      {"name":"Entidade","text":{"maxLength":80},"required":true},
      {"name":"EntidadeId","text":{"maxLength":80},"required":true},
      {"name":"Acao","text":{"maxLength":80},"required":true},
      {"name":"PedidoId","text":{"maxLength":80},"indexed":true}
    ]}
  ],
  "libraries": [
    {"name":"MDP_Documentos","description":"Fotografias e documentos associados a equipamentos e trabalhos.","columns":[
      {"name":"EquipamentoId","number":{"decimalPlaces":"none","minimum":1},"indexed":true},
      {"name":"TrabalhoId","number":{"decimalPlaces":"none","minimum":1},"indexed":true}
    ]}
  ],
  "rules":[
    "Title corresponde à designação da unidade/equipamento ou ao título do trabalho.",
    "Referências entre listas são verificadas no servidor: existência, unidade e ausência de ciclos.",
    "Os técnicos nunca recebem credenciais de aplicação nem permissões diretas de escrita no SharePoint.",
    "O servidor valida identidade, perfil, autoria, valores e ficheiros antes de gravar.",
    "A criação de utilizadores externos é uma operação administrativa no fornecedor de identidade, não nesta lista.",
    "Não criar tarefas, equipamentos ou trabalhos de demonstração.",
    "Atualizações usam ETag para rejeitar conflitos; pedidos de criação usam PedidoId para evitar duplicados.",
    "A eliminação de equipamento preserva os trabalhos e o histórico; eliminação definitiva requer ação explícita."
  ]
}
